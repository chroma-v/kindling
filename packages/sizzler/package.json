{
  "name": "sizzler",
  "version": "0.1.7",
  "description": "Sizzling column factories and utilities for Drizzle ORM with SQLite, D1, and Turso",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0",
    "drizzle-orm": ">=0.30.0 || >=1.0.0-beta.1",
    "drizzle-seed": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-seed": {
      "optional": true
    }
  },
  "dependencies": {
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-seed": "1.0.0-rc.5-ab785fc",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "sizzler",
    "drizzle",
    "orm",
    "sqlite",
    "d1",
    "cloudflare",
    "turso",
    "column-factories",
    "ulid"
  ],
  "author": "Cobaltplan",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chroma-v/kindling.git",
    "directory": "packages/sizzler"
  },
  "homepage": "https://github.com/chroma-v/kindling/tree/main/packages/sizzler#readme",
  "bugs": {
    "url": "https://github.com/chroma-v/kindling/issues"
  }
}
